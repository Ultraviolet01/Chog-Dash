# Required in production: random secret used to sign sign-in tokens (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Optional: Monad RPC used by the server and scripts (defaults to the RPC in js/config.js)
MONAD_RPC_URL=
# Leaderboard storage (Upstash Redis REST). Without these the server uses memory and loses data on restart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
