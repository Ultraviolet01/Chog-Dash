# Required in production: random secret used to sign sign-in tokens (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Required in production: Supabase leaderboard storage. Run supabase/schema.sql once first.
# Supabase dashboard > Project Settings > API (or Data API):
#   SUPABASE_URL = Project URL, e.g. https://abcdefgh.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY = the service_role secret key (server only, never in the browser or in git)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Monad RPC used by the server and scripts (defaults to the RPC in js/config.js)
MONAD_RPC_URL=
